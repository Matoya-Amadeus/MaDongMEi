# Public defaults for the open MaDongMei layer.
CODEX_HOME=${HOME}/.codex
MADONGMEI_HOME=${HOME}/.madongmei
MADONGMEI_DATA_DIR=${MADONGMEI_HOME}/data
MADONGMEI_LOG_DIR=${MADONGMEI_HOME}/logs
MADONGMEI_CACHE_DIR=${MADONGMEI_HOME}/cache
MADONGMEI_DB_PATH=${MADONGMEI_DATA_DIR}/memory.jsonl
MADONGMEI_BRIDGE_ROOT=${CODEX_HOME}/.madongmei-runtime
WORKSPACE_SOURCE_ROOT=${MADONGMEI_BRIDGE_ROOT}/workspaces/MaDongMei
WORKSPACE_SOURCE_LINK=${WORKSPACE_SOURCE_ROOT}/.agent-memory
WORKSPACE_ROOT=${WORKSPACE_SOURCE_ROOT}
MEMORY_RUNTIME_DIR=${MADONGMEI_BRIDGE_ROOT}/memory
WORKSPACE_REGISTRY_FILE=${MEMORY_RUNTIME_DIR}/state/workspace_registry.json
MADONGMEI_GRAPH_DIR=${MEMORY_RUNTIME_DIR}/graph
MADONGMEI_GRAPH_RUNTIME_DIR=${MADONGMEI_GRAPH_DIR}
MADONGMEI_GRAPH_DB_PATH=${MADONGMEI_GRAPH_DIR}/personal.db
MADONGMEI_GRAPH_SNAPSHOT_DIR=${MADONGMEI_GRAPH_DIR}/snapshots
